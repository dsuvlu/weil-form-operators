{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"Riemann.Source.source_norm_sq_decomposition","type":"∀ {E : Type u_1} {F : Type u_2} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℂ E]\n  [inst_2 : CompleteSpace E] [inst_3 : NormedAddCommGroup F] [inst_4 : InnerProductSpace ℂ F] [inst_5 : CompleteSpace F]\n  [inst_6 : FiniteDimensional ℂ F] (T : E →L[ℂ] F) (hT : Function.Surjective ⇑T) (y : F) (x : E),\n  T x = y → ‖x‖ ^ 2 = ‖(Riemann.Source.minimumNormMap T hT) y‖ ^ 2 + ‖x - (Riemann.Source.minimumNormMap T hT) y‖ ^ 2","unsafe":false}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"Riemann.Basic.hasDerivAt_inverseContraction","type":"∀ {ι : Type u_1} [inst : Fintype ι] [inst_1 : DecidableEq ι] (A B : Matrix ι ι ℝ) (s : ℝ),\n  IsUnit (A + s • B) →\n    ∀ (x y : ι → ℝ),\n      HasDerivAt (fun t => x ⬝ᵥ (A + t • B)⁻¹.mulVec y) (-(x ⬝ᵥ ((A + s • B)⁻¹ * B * (A + s • B)⁻¹).mulVec y)) s","unsafe":false}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"Riemann.Analysis.FiniteWindow.inner_volterra_cross","type":"∀ {L : ℝ},\n  0 ≤ L →\n    ∀ (b : ℝ) {f g : ℝ → ℂ} (hf : Continuous f) (hg : Continuous g),\n      inner ℂ (Riemann.Analysis.FiniteWindow.ofContinuous L f hf)\n            ((Riemann.Analysis.FiniteWindow.volterra L ↑b) (Riemann.Analysis.FiniteWindow.ofContinuous L g hg)) +\n          inner ℂ ((Riemann.Analysis.FiniteWindow.volterra L (-↑b)) (Riemann.Analysis.FiniteWindow.ofContinuous L f hf))\n            (Riemann.Analysis.FiniteWindow.ofContinuous L g hg) =\n        (∫ (t : ℝ) in 0..L, ↑(Real.exp (b * t)) * star (f t)) * ∫ (t : ℝ) in 0..L, ↑(Real.exp (-b * t)) * g t","unsafe":false}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"Riemann.Analysis.FiniteWindow.inner_polarVolterra","type":"∀ {L : ℝ},\n  0 ≤ L →\n    ∀ {f g : ℝ → ℂ} (hf : Continuous f) (hg : Continuous g),\n      inner ℂ (Riemann.Analysis.FiniteWindow.ofContinuous L f hf)\n            ((Riemann.Analysis.FiniteWindow.volterra L (1 / 2) + Riemann.Analysis.FiniteWindow.volterra L (-(1 / 2)))\n              (Riemann.Analysis.FiniteWindow.ofContinuous L g hg)) +\n          inner ℂ\n            ((Riemann.Analysis.FiniteWindow.volterra L (1 / 2) + Riemann.Analysis.FiniteWindow.volterra L (-(1 / 2)))\n              (Riemann.Analysis.FiniteWindow.ofContinuous L f hf))\n            (Riemann.Analysis.FiniteWindow.ofContinuous L g hg) =\n        ((∫ (t : ℝ) in 0..L, ↑(Real.exp (t / 2)) * star (f t)) * ∫ (t : ℝ) in 0..L, ↑(Real.exp (-t / 2)) * g t) +\n          (∫ (t : ℝ) in 0..L, ↑(Real.exp (-t / 2)) * star (f t)) * ∫ (t : ℝ) in 0..L, ↑(Real.exp (t / 2)) * g t","unsafe":false}
