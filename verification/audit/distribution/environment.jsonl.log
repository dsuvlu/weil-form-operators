{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"Riemann.Capacity.GraphData.mk.inj","type":"∀ {U : Type u_3} {W : Type u_4} {inst : NormedAddCommGroup U} {inst_1 : InnerProductSpace ℂ U}\n  {inst_2 : FiniteDimensional ℂ U} {inst_3 : NormedAddCommGroup W} {inst_4 : InnerProductSpace ℂ W}\n  {inst_5 : FiniteDimensional ℂ W} {metric : Riemann.Basic.PositiveSchur.Data U W}\n  {K : Riemann.Basic.PositiveSchur.Space U W →L[ℂ] Riemann.Basic.PositiveSchur.Space U W}\n  {selfK : ContinuousLinearMap.adjoint K = K}\n  {positiveK : ∀ (z : Riemann.Basic.PositiveSchur.Space U W), z ≠ 0 → 0 < (inner ℂ z (K z)).re} {A₁ : U →L[ℂ] U}\n  {A₂ : W →L[ℂ] W} {beta zeta : Riemann.Basic.PositiveSchur.Space U W}\n  {displacement :\n    K =\n      Riemann.Basic.PositiveSchur.block metric.A metric.B metric.C ∘SL Riemann.Basic.PositiveSchur.block A₁ 0 A₂ +\n        ((InnerProductSpace.rankOne ℂ) beta) zeta}\n  {metric_1 : Riemann.Basic.PositiveSchur.Data U W}\n  {K_1 : Riemann.Basic.PositiveSchur.Space U W →L[ℂ] Riemann.Basic.PositiveSchur.Space U W}\n  {selfK_1 : ContinuousLinearMap.adjoint K_1 = K_1}\n  {positiveK_1 : ∀ (z : Riemann.Basic.PositiveSchur.Space U W), z ≠ 0 → 0 < (inner ℂ z (K_1 z)).re} {A₁_1 : U →L[ℂ] U}\n  {A₂_1 : W →L[ℂ] W} {beta_1 zeta_1 : Riemann.Basic.PositiveSchur.Space U W}\n  {displacement_1 :\n    K_1 =\n      Riemann.Basic.PositiveSchur.block metric_1.A metric_1.B metric_1.C ∘SL\n          Riemann.Basic.PositiveSchur.block A₁_1 0 A₂_1 +\n        ((InnerProductSpace.rankOne ℂ) beta_1) zeta_1},\n  { metric := metric, K := K, selfK := selfK, positiveK := positiveK, A₁ := A₁, A₂ := A₂, beta := beta, zeta := zeta,\n        displacement := displacement } =\n      { metric := metric_1, K := K_1, selfK := selfK_1, positiveK := positiveK_1, A₁ := A₁_1, A₂ := A₂_1,\n        beta := beta_1, zeta := zeta_1, displacement := displacement_1 } →\n    metric = metric_1 ∧ K = K_1 ∧ A₁ = A₁_1 ∧ A₂ = A₂_1 ∧ beta = beta_1 ∧ zeta = zeta_1","unsafe":false}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"Riemann.Capacity.RankOneBlocks.inverse_normal_mass","type":"∀ {U : Type u_1} {W : Type u_2} [inst : NormedAddCommGroup U] [inst_1 : InnerProductSpace ℂ U]\n  [inst_2 : FiniteDimensional ℂ U] [inst_3 : NormedAddCommGroup W] [inst_4 : InnerProductSpace ℂ W]\n  [inst_5 : FiniteDimensional ℂ W] (M : Riemann.Basic.PositiveSchur.Data U W) (beta : U) (zeta : W),\n  M.B = ((InnerProductSpace.rankOne ℂ) beta) zeta →\n    beta ≠ 0 →\n      ∀ (R : U →L[ℂ] U) (T : W →L[ℂ] W),\n        (inner ℂ\n              ((Riemann.Basic.positiveInverse (Riemann.Basic.PositiveSchur.block M.A M.B M.C) ⋯)\n                (Riemann.Capacity.lowIncl beta))\n              ((Riemann.Basic.PositiveSchur.block R 0 T)\n                ((Riemann.Basic.positiveInverse (Riemann.Basic.PositiveSchur.block M.A M.B M.C) ⋯)\n                  (Riemann.Capacity.lowIncl beta)))).re =\n          ((inner ℂ (Riemann.Capacity.RankOneBlocks.lowResponse M beta)\n                  (R (Riemann.Capacity.RankOneBlocks.lowResponse M beta))).re +\n              Riemann.Capacity.RankOneBlocks.theta M beta ^ 2 *\n                (inner ℂ (Riemann.Capacity.RankOneBlocks.highResponse M zeta)\n                    (T (Riemann.Capacity.RankOneBlocks.highResponse M zeta))).re) /\n            Riemann.Capacity.RankOneBlocks.denominator M beta zeta ^ 2","unsafe":false}
