{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"Riemann.Basic.hyperplane_inverse_defect","type":"∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℂ E] [inst_2 : FiniteDimensional ℂ E]\n  (H : E →L[ℂ] E) (hH : ∀ (x : E), x ≠ 0 → 0 < (inner ℂ x (H x)).re),\n  (↑H).IsSymmetric →\n    ∀ (eta : E),\n      eta ≠ 0 →\n        Riemann.Basic.positiveInverse H hH -\n            (Riemann.Basic.vectorHyperplane eta).subtypeL ∘SL\n              Riemann.Basic.positiveInverse (Riemann.Basic.physicalCompression (Riemann.Basic.vectorHyperplane eta) H)\n                  ⋯ ∘SL\n                (Riemann.Basic.vectorHyperplane eta).orthogonalProjectionOnto =\n          (inner ℂ eta ((Riemann.Basic.positiveInverse H hH) eta))⁻¹ •\n            ((InnerProductSpace.rankOne ℂ) ((Riemann.Basic.positiveInverse H hH) eta))\n              ((Riemann.Basic.positiveInverse H hH) eta)","unsafe":false}
{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"Riemann.Basic.PositiveSchur.ThreeData.firstLift_energy._abel_1_4","type":"∀ {U : Type u_1} {V : Type u_2} {W : Type u_3} [inst : NormedAddCommGroup U] [inst_1 : InnerProductSpace ℂ U]\n  [inst_2 : FiniteDimensional ℂ U] [inst_3 : NormedAddCommGroup V] [inst_4 : InnerProductSpace ℂ V]\n  [inst_5 : FiniteDimensional ℂ V] [inst_6 : NormedAddCommGroup W] [inst_7 : InnerProductSpace ℂ W]\n  [inst_8 : FiniteDimensional ℂ W] (T : Riemann.Basic.PositiveSchur.ThreeData U V W)\n  (z : Riemann.Basic.PositiveSchur.Space U V),\n  inner ℂ (WithLp.fst z) (T.A (WithLp.fst z)) +\n        (inner ℂ (WithLp.fst z) (T.D (WithLp.snd z)) +\n          -(inner ℂ (WithLp.fst z) (T.E (T.tail.inverseC ((ContinuousLinearMap.adjoint T.E) (WithLp.fst z)))) +\n              inner ℂ (WithLp.fst z) (T.E (T.tail.inverseC ((ContinuousLinearMap.adjoint T.tail.B) (WithLp.snd z)))))) +\n      (inner ℂ (WithLp.snd z) ((ContinuousLinearMap.adjoint T.D) (WithLp.fst z)) +\n        (inner ℂ (WithLp.snd z) (T.tail.A (WithLp.snd z)) +\n          -(inner ℂ (WithLp.snd z) (T.tail.B (T.tail.inverseC ((ContinuousLinearMap.adjoint T.E) (WithLp.fst z)))) +\n              inner ℂ (WithLp.snd z)\n                (T.tail.B (T.tail.inverseC ((ContinuousLinearMap.adjoint T.tail.B) (WithLp.snd z))))))) =\n    inner ℂ (WithLp.fst z) (T.A (WithLp.fst z)) -\n          inner ℂ (WithLp.fst z) (T.E (T.tail.inverseC ((ContinuousLinearMap.adjoint T.E) (WithLp.fst z)))) +\n        (inner ℂ (WithLp.fst z) (T.D (WithLp.snd z)) -\n          inner ℂ (WithLp.fst z) (T.E (T.tail.inverseC ((ContinuousLinearMap.adjoint T.tail.B) (WithLp.snd z))))) +\n      (inner ℂ (WithLp.snd z) ((ContinuousLinearMap.adjoint T.D) (WithLp.fst z)) -\n          inner ℂ (WithLp.snd z) (T.tail.B (T.tail.inverseC ((ContinuousLinearMap.adjoint T.E) (WithLp.fst z)))) +\n        (inner ℂ (WithLp.snd z) (T.tail.A (WithLp.snd z)) -\n          inner ℂ (WithLp.snd z) (T.tail.B (T.tail.inverseC ((ContinuousLinearMap.adjoint T.tail.B) (WithLp.snd z))))))","unsafe":false}
