 x • eta} →\n                                                  {finite_dimensional' : FiniteDimensional ℂ E} →\n                                                    {H' D' reflection' : E →L[ℂ] E} →\n                                                      {eta' b' ground' constant' : E} →\n                                                        {e₀' : ℝ} →\n                                                          {H_selfadjoint' : ContinuousLinearMap.adjoint H' = H'} →\n                                                            {D_selfadjoint' : ContinuousLinearMap.adjoint D' = D'} →\n                                                              {reflection_selfadjoint' :\n                                                                  ContinuousLinearMap.adjoint reflection' =\n                                                                    reflection'} →\n                                                                {reflection_involutive' :\n                                                                    ∀ (x : E), reflection' (reflection' x) = x} →\n                                                                  {reflection_H' :\n                                                                      ∀ (x : E),\n                                                                        reflection' (H' x) = H' (reflection' x)} →\n                                                                    {reflection_D' :\n                                                                        ∀ (x : E),\n                                                                          reflection' (D' x) = -D' (reflection' x)} →\n                                                                      {eta_even' : reflection' eta' = eta'} →\n                                                                        {b_odd' : reflection' b' = -b'} →\n                                                                          {ground_even' :\n                                                                              reflection' ground' = ground'} →\n                                                                            {ground_ne_zero' : ground' ≠ 0} →\n                                                                              {ground_eigen' :\n                                                                                  H' ground' = ↑e₀' • ground'} →\n                                                                                {least' :\n                                                                                    ∀ (x : E),\n                                                                                      e₀' * ‖x‖ ^ 2 ≤\n                                                                                        (inner ℂ x (H' x)).re} →\n                                                                                  {simple' :\n                                                                                      ∀ (x : E),\n                                                                                        H' x = ↑e₀' • x ↔\n                                                                                          ∃ a, x = a • ground'} →\n                                                                                    {constant_kernel' :\n                                                                                        ∀ (x : E),\n                                                                                          D' x = 0 ↔\n                                                                                            ∃ a, x = a • constant'} →\n                                                                                      {constant_bright' :\n                                                                                          inner ℂ eta' constant' ≠ 0} →\n                                                                                        {displacement' :\n                                                                                            ∀ (x : E),\n                                                                                              D' (H' x) - H' (D' x) =\n                                                                                                inner ℂ eta' x • b' -\n                                                                                                  inner ℂ b' x • eta'} →\n                                                                                          {\n                                                                                                finite_dimensional :=\n                                                                                                  finite_dimensional,\n                                                                                                H := H, D := D,\n                                                                                                reflection :=\n                                                                                                  reflection,\n                                                                                                eta := eta, b := b,\n                                                                                                ground := ground,\n                                                                                                constant := constant,\n                                                                                                e₀ := e₀,\n                                                                                                H_selfadjoint :=\n                                                                                                  H_selfadjoint,\n                                                                                                D_selfadjoint :=\n                                                                                                  D_selfadjoint,\n                                                                                                reflection_selfadjoint :=\n                                                                                                  reflection_selfadjoint,\n                                                                                                reflection_involutive :=\n                                                                                                  reflection_involutive,\n                                                                                                reflection_H :=\n                                                                                                  reflection_H,\n                                                                                                reflection_D :=\n                                                                                                  reflection_D,\n                                                                                                eta_even := eta_even,\n                                                                                                b_odd := b_odd,\n                                                                                                ground_even :=\n                                                                                                  ground_even,\n                                                                                                ground_ne_zero :=\n                                                                                                  ground_ne_zero,\n                                                                                                ground_eigen :=\n                                                                                                  ground_eigen,\n                                                                                                least := least,\n                  