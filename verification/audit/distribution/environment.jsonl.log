{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"Riemann.CCM.FullSimpleEvenData.mk.inj","type":"∀ {E : Type u_1} {inst : NormedAddCommGroup E} {inst_1 : InnerProductSpace ℂ E} {inst_2 : CompleteSpace E}\n  {finite_dimensional : FiniteDimensional ℂ E} {H D reflection : E →L[ℂ] E} {eta b ground constant : E} {e₀ : ℝ}\n  {H_selfadjoint : ContinuousLinearMap.adjoint H = H} {D_selfadjoint : ContinuousLinearMap.adjoint D = D}\n  {reflection_selfadjoint : ContinuousLinearMap.adjoint reflection = reflection}\n  {reflection_involutive : ∀ (x : E), reflection (reflection x) = x}\n  {reflection_H : ∀ (x : E), reflection (H x) = H (reflection x)}\n  {reflection_D : ∀ (x : E), reflection (D x) = -D (reflection x)} {eta_even : reflection eta = eta}\n  {b_odd : reflection b = -b} {ground_even : reflection ground = ground} {ground_ne_zero : ground ≠ 0}\n  {ground_eigen : H ground = ↑e₀ • ground} {least : ∀ (x : E), e₀ * ‖x‖ ^ 2 ≤ (inner ℂ x (H x)).re}\n  {simple : ∀ (x : E), H x = ↑e₀ • x ↔ ∃ a, x = a • ground}\n  {constant_kernel : ∀ (x : E), D x = 0 ↔ ∃ a, x = a • constant} {constant_bright : inner ℂ eta constant ≠ 0}\n  {displacement : ∀ (x : E), D (H x) - H (D x) = inner ℂ eta x • b - inner ℂ b x • eta}\n  {finite_dimensional_1 : FiniteDimensional ℂ E} {H_1 D_1 reflection_1 : E →L[ℂ] E} {eta_1 b_1 ground_1 constant_1 : E}\n  {e₀_1 : ℝ} {H_selfadjoint_1 : ContinuousLinearMap.adjoint H_1 = H_1}\n  {D_selfadjoint_1 : ContinuousLinearMap.adjoint D_1 = D_1}\n  {reflection_selfadjoint_1 : ContinuousLinearMap.adjoint reflection_1 = reflection_1}\n  {reflection_involutive_1 : ∀ (x : E), reflection_1 (reflection_1 x) = x}\n  {reflection_H_1 : ∀ (x : E), reflection_1 (H_1 x) = H_1 (reflection_1 x)}\n  {reflection_D_1 : ∀ (x : E), reflection_1 (D_1 x) = -D_1 (reflection_1 x)} {eta_even_1 : reflection_1 eta_1 = eta_1}\n  {b_odd_1 : reflection_1 b_1 = -b_1} {ground_even_1 : reflection_1 ground_1 = ground_1}\n  {ground_ne_zero_1 : ground_1 ≠ 0} {ground_eigen_1 : H_1 ground_1 = ↑e₀_1 • ground_1}\n  {least_1 : ∀ (x : E), e₀_1 * ‖x‖ ^ 2 ≤ (inner ℂ x (H_1 x)).re}\n  {simple_1 : ∀ (x : E), H_1 x = ↑e₀_1 • x ↔ ∃ a, x = a • ground_1}\n  {constant_kernel_1 : ∀ (x : E), D_1 x = 0 ↔ ∃ a, x = a • constant_1}\n  {constant_bright_1 : inner ℂ eta_1 constant_1 ≠ 0}\n  {displacement_1 : ∀ (x : E), D_1 (H_1 x) - H_1 (D_1 x) = inner ℂ eta_1 x • b_1 - inner ℂ b_1 x • eta_1},\n  { finite_dimensional := finite_dimensional, H := H, D := D, reflection := reflection, eta := eta, b := b,\n        ground := ground, constant := constant, e₀ := e₀, H_selfadjoint := H_selfadjoint,\n        D_selfadjoint := D_selfadjoint, reflection_selfadjoint := reflection_selfadjoint,\n        reflection_involutive := reflection_involutive, reflection_H := reflection_H, reflection_D := reflection_D,\n        eta_even := eta_even, b_odd := b_odd, ground_even := ground_even, ground_ne_zero := ground_ne_zero,\n        ground_eigen := ground_eigen, least := least, simple := simple, constant_kernel := constant_kernel,\n        constant_bright := constant_bright, displacement := displacement } =\n      { finite_dimensional := finite_dimensional_1, H := H_1, D := D_1, reflection := reflection_1, eta := eta_1,\n        b := b_1, ground := ground_1, constant := constant_1, e₀ := e₀_1, H_selfadjoint := H_selfadjoint_1,\n        D_selfadjoint := D_selfadjoint_1, reflection_selfadjoint := reflection_selfadjoint_1,\n        reflection_involutive := reflection_involutive_1, reflection_H := reflection_H_1,\n        reflection_D := reflection_D_1, eta_even := eta_even_1, b_odd := b_odd_1, ground_even := ground_even_1,\n        ground_ne_zero := ground_ne_zero_1, ground_eigen := ground_eigen_1, least := least_1, simple := simple_1,\n        constant_kernel := constant_kernel_1, constant_bright := constant_bright_1, displacement := displacement_1 } →\n    H = H_1 ∧\n      D = D_1 ∧\n        reflection = reflection_1 ∧ eta = eta_1 ∧ b = b_1 ∧ ground = ground_1 ∧ constant = constant_1 ∧ e₀ = e₀_1","unsafe":false}
