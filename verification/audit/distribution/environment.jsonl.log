   ground_ne_zero',\n                                                                                                ground_eigen :=\n                                                                                                  ground_eigen',\n                                                                                                least := least',\n                                                                                                simple := simple',\n                                                                                                constant_kernel :=\n                                                                                                  constant_kernel',\n                                                                                                constant_bright :=\n                                                                                                  constant_bright',\n                                                                                                displacement :=\n                                                                                                  displacement' } →\n                                                                                            (H ≍ H' →\n                                                                                                D ≍ D' →\n                                                                                                  reflection ≍\n                                                                                                      reflection' →\n                                                                                                    eta ≍ eta' →\n                                                                                                      b ≍ b' →\n                                                                                                        ground ≍\n                                                