{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"Riemann.CCM.Native.GroundAdmission.mk.injEq","type":"∀ {N : ℕ} {C : Riemann.CCM.Native.Coefficients N} (ground : Riemann.CCM.Native.Section N) (e₀ : ℝ)\n  (nonzero : ground ≠ 0) (even : (Riemann.CCM.Native.reflection N) ground = ground)\n  (eigen : (Riemann.CCM.Native.weilOperator C) ground = ↑e₀ • ground)\n  (least : ∀ (x : Riemann.CCM.Native.Section N), e₀ * ‖x‖ ^ 2 ≤ (inner ℂ x ((Riemann.CCM.Native.weilOperator C) x)).re)\n  (simple : ∀ (x : Riemann.CCM.Native.Section N), (Riemann.CCM.Native.weilOperator C) x = ↑e₀ • x ↔ ∃ a, x = a • ground)\n  (ground_1 : Riemann.CCM.Native.Section N) (e₀_1 : ℝ) (nonzero_1 : ground_1 ≠ 0)\n  (even_1 : (Riemann.CCM.Native.reflection N) ground_1 = ground_1)\n  (eigen_1 : (Riemann.CCM.Native.weilOperator C) ground_1 = ↑e₀_1 • ground_1)\n  (least_1 :\n    ∀ (x : Riemann.CCM.Native.Section N), e₀_1 * ‖x‖ ^ 2 ≤ (inner ℂ x ((Riemann.CCM.Native.weilOperator C) x)).re)\n  (simple_1 :\n    ∀ (x : Riemann.CCM.Native.Section N), (Riemann.CCM.Native.weilOperator C) x = ↑e₀_1 • x ↔ ∃ a, x = a • ground_1),\n  ({ ground := ground, e₀ := e₀, nonzero := nonzero, even := even, eigen := eigen, least := least, simple := simple } =\n      { ground := ground_1, e₀ := e₀_1, nonzero := nonzero_1, even := even_1, eigen := eigen_1, least := least_1,\n        simple := simple_1 }) =\n    (ground = ground_1 ∧ e₀ = e₀_1)","unsafe":false}
