{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"Riemann.Basic.PositiveSchur.ThreeData.mk.injEq","type":"∀ {U : Type u_4} {V : Type u_5} {W : Type u_6} [inst : NormedAddCommGroup U] [inst_1 : InnerProductSpace ℂ U]\n  [inst_2 : FiniteDimensional ℂ U] [inst_3 : NormedAddCommGroup V] [inst_4 : InnerProductSpace ℂ V]\n  [inst_5 : FiniteDimensional ℂ V] [inst_6 : NormedAddCommGroup W] [inst_7 : InnerProductSpace ℂ W]\n  [inst_8 : FiniteDimensional ℂ W] (A : U →L[ℂ] U) (D : V →L[ℂ] U) (E : W →L[ℂ] U)\n  (tail : Riemann.Basic.PositiveSchur.Data V W) (selfA : ContinuousLinearMap.adjoint A = A)\n  (positive :\n    ∀ (z : Riemann.Basic.PositiveSchur.Space U (Riemann.Basic.PositiveSchur.Space V W)),\n      z ≠ 0 →\n        0 <\n          (inner ℂ z\n              ((Riemann.Basic.PositiveSchur.block A (Riemann.Basic.PositiveSchur.row D E)\n                  (Riemann.Basic.PositiveSchur.block tail.A tail.B tail.C))\n                z)).re)\n  (A_1 : U →L[ℂ] U) (D_1 : V →L[ℂ] U) (E_1 : W →L[ℂ] U) (tail_1 : Riemann.Basic.PositiveSchur.Data V W)\n  (selfA_1 : ContinuousLinearMap.adjoint A_1 = A_1)\n  (positive_1 :\n    ∀ (z : Riemann.Basic.PositiveSchur.Space U (Riemann.Basic.PositiveSchur.Space V W)),\n      z ≠ 0 →\n        0 <\n          (inner ℂ z\n              ((Riemann.Basic.PositiveSchur.block A_1 (Riemann.Basic.PositiveSchur.row D_1 E_1)\n                  (Riemann.Basic.PositiveSchur.block tail_1.A tail_1.B tail_1.C))\n                z)).re),\n  ({ A := A, D := D, E := E, tail := tail, selfA := selfA, positive := positive } =\n      { A := A_1, D := D_1, E := E_1, tail := tail_1, selfA := selfA_1, positive := positive_1 }) =\n    (A = A_1 ∧ D = D_1 ∧ E = E_1 ∧ tail = tail_1)","unsafe":false}
