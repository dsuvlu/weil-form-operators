{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","name":"Riemann.Capacity.GraphData.mk.congr_simp","type":"∀ {U : Type u_3} {W : Type u_4} [inst : NormedAddCommGroup U] [inst_1 : InnerProductSpace ℂ U]\n  [inst_2 : FiniteDimensional ℂ U] [inst_3 : NormedAddCommGroup W] [inst_4 : InnerProductSpace ℂ W]\n  [inst_5 : FiniteDimensional ℂ W] (metric metric_1 : Riemann.Basic.PositiveSchur.Data U W)\n  (e_metric : metric = metric_1)\n  (K K_1 : Riemann.Basic.PositiveSchur.Space U W →L[ℂ] Riemann.Basic.PositiveSchur.Space U W) (e_K : K = K_1)\n  (selfK : ContinuousLinearMap.adjoint K = K)\n  (positiveK : ∀ (z : Riemann.Basic.PositiveSchur.Space U W), z ≠ 0 → 0 < (inner ℂ z (K z)).re) (A₁ A₁_1 : U →L[ℂ] U)\n  (e_A₁ : A₁ = A₁_1) (A₂ A₂_1 : W →L[ℂ] W) (e_A₂ : A₂ = A₂_1) (beta beta_1 : Riemann.Basic.PositiveSchur.Space U W)\n  (e_beta : beta = beta_1) (zeta zeta_1 : Riemann.Basic.PositiveSchur.Space U W) (e_zeta : zeta = zeta_1)\n  (displacement :\n    K =\n      Riemann.Basic.PositiveSchur.block metric.A metric.B metric.C ∘SL Riemann.Basic.PositiveSchur.block A₁ 0 A₂ +\n        ((InnerProductSpace.rankOne ℂ) beta) zeta),\n  { metric := metric, K := K, selfK := selfK, positiveK := positiveK, A₁ := A₁, A₂ := A₂, beta := beta, zeta := zeta,\n      displacement := displacement } =\n    { metric := metric_1, K := K_1, selfK := ⋯, positiveK := ⋯, A₁ := A₁_1, A₂ := A₂_1, beta := beta_1, zeta := zeta_1,\n      displacement := ⋯ }","unsafe":false}
