{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"constructor","name":"Riemann.CCM.FullSimpleEvenData.mk","type":"{E : Type u_1} →\n  [inst : NormedAddCommGroup E] →\n    [inst_1 : InnerProductSpace ℂ E] →\n      [inst_2 : CompleteSpace E] →\n        FiniteDimensional ℂ E →\n          (H D reflection : E →L[ℂ] E) →\n            (eta b ground constant : E) →\n              (e₀ : ℝ) →\n                ContinuousLinearMap.adjoint H = H →\n                  ContinuousLinearMap.adjoint D = D →\n                    ContinuousLinearMap.adjoint reflection = reflection →\n                      (∀ (x : E), reflection (reflection x) = x) →\n                        (∀ (x : E), reflection (H x) = H (reflection x)) →\n                          (∀ (x : E), reflection (D x) = -D (reflection x)) →\n                            reflection eta = eta →\n                              reflection b = -b →\n                                reflection ground = ground →\n                                  ground ≠ 0 →\n                                    H ground = ↑e₀ • ground →\n                                      (∀ (x : E), e₀ * ‖x‖ ^ 2 ≤ (inner ℂ x (H x)).re) →\n                                        (∀ (x : E), H x = ↑e₀ • x ↔ ∃ a, x = a • ground) →\n                                          (∀ (x : E), D x = 0 ↔ ∃ a, x = a • constant) →\n                                            inner ℂ eta constant ≠ 0 →\n                                              (∀ (x : E), D (H x) - H (D x) = inner ℂ eta x • b - inner ℂ b x • eta) →\n                                                Riemann.CCM.FullSimpleEvenData E","unsafe":false}
