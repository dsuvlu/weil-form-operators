n      ground_even := ground_even, ground_ne_zero := ground_ne_zero, ground_eigen := ground_eigen, least := least,\n      simple := simple, constant_kernel := constant_kernel, constant_bright := constant_bright,\n      displacement := displacement } =\n    { finite_dimensional := finite_dimensional, H := H_1, D := D_1, reflection := reflection_1, eta := eta_1, b := b_1,\n      ground := ground_1, constant := constant_1, e₀ := e₀_1, H_selfadjoint := ⋯, D_selfadjoint := ⋯,\n      reflection_selfadjoint := ⋯, reflection_involutive := ⋯, reflection_H := ⋯, reflection_D := ⋯, eta_even := ⋯,\n      b_odd := ⋯, ground_even := ⋯, ground_ne_zero := ⋯, ground_eigen := ⋯, least := ⋯, simple := ⋯,\n      constant_kernel := ⋯, constant_bright := ⋯, displacement := ⋯ }","unsafe":false}
